<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge, no action bar: Compose draws everything. The window
         background only shows during launch, before Compose's first frame. -->
    <style name="Theme.__APP_NAME__" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFBFE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
