<?xml version="1.0" encoding="utf-8"?>
<!-- The large saved-cities widget (item 36b): 4×4 cells, resizable; the layout
     follows the city count (WidgetLayoutPlan) and the type follows the space
     the launcher gives (SavedCitiesWidgetSizing). updatePeriodMillis is the
     30-minute floor — the ticking time is TextClock's own, this refresh only
     renews the day markers and offset phrases. minWidth/minHeight are the
     pre-Android-12 cell formula (70 × cells − 30). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_saved_cities"
    android:previewLayout="@layout/widget_saved_cities"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
