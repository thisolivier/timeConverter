<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tile glyph: a clock face whose rim is an arrow (convert).
     Solid white on transparent, 24dp; the system tints it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Rim: 300 degrees clockwise, open at the top. -->
    <path
        android:pathData="M16,6.07 A8,8 0 1,1 8,6.07"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Arrowhead at the rim's end, pointing into the gap. -->
    <path
        android:pathData="M10.6,4.6 L9.2,8.1 L6.6,4.3 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- Hands. -->
    <path
        android:pathData="M12,9.5 L12,13 L14.6,14.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
