<?xml version="1.0" encoding="utf-8"?>
<!-- One city on the large widget: label, a very big time, a hairline, the
     offset phrase — the block centred in the widget's height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/cell_label"
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/widget_time_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/widget_hairline" />

    <TextView
        android:id="@+id/cell_caption"
        style="@style/WidgetCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
