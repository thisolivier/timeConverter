<?xml version="1.0" encoding="utf-8"?>
<!-- One city on the small widget: label at the top, the time in the middle,
     the offset phrase at the foot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cell_label"
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/widget_time_row" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/cell_caption"
        style="@style/WidgetCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
