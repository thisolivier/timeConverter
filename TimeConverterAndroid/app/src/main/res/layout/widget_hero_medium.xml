<?xml version="1.0" encoding="utf-8"?>
<!-- One city on the medium widget: label over a big time, a rule, then the
     offset phrase one word per line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cell_label"
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <include layout="@layout/widget_time_row" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="4dp"
        android:background="@color/widget_hairline" />

    <TextView
        android:id="@+id/cell_caption"
        style="@style/WidgetCaption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="4" />
</LinearLayout>
