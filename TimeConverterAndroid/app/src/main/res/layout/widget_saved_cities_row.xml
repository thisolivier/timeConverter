<?xml version="1.0" encoding="utf-8"?>
<!-- One clock: name and zone line on the left, the ticking time and the
     offset phrase on the right. The same slots as WorldClockRowView, laid
     sideways because a widget row has width to spare and height to ration. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_place_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_zone_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.10"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="@color/widget_quiet_ink"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/row_clock_digits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/widget_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/row_clock_meridiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-condensed"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="@color/widget_ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_offset_phrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_quiet_ink"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
